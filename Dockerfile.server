# =============================================================================
# Dockerfile.server - Central Aggregator Server untuk GCP e2-micro (1GB RAM)
# =============================================================================
# Optimized untuk:
# - Minimal memory footprint (hanya ~100-150MB)
# - Lightweight aggregation menggunakan FedAvg
# - Tidak perlu PyTorch atau CUDA (hanya agregasi)
# - Base image: python:3.10-slim (sangat ringan ~200MB)
# =============================================================================

FROM python:3.10-slim

# Metadata
LABEL maintainer="FL Weather Prediction Team"
LABEL description="Memory-optimized Flower Server for GCP e2-micro"
LABEL version="1.0"

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /app

# Install minimal system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip --no-cache-dir

# Install Python dependencies (NO PyTorch/CUDA - server hanya perlu flwr & numpy)
RUN pip install --no-cache-dir \
    flwr[simulation]>=1.8.0 \
    numpy>=1.23.0 \
    pandas>=1.5.0 \
    protobuf>=3.20.0

# Copy source code
COPY src/server.py /app/server.py
COPY src/model.py /app/model.py
COPY src/config.py /app/config.py
COPY src/utils.py /app/utils.py
COPY src/__init__.py /app/__init__.py

# Create logs directory
RUN mkdir -p /app/logs

# Expose gRPC port
EXPOSE 8080

# Health check - test gRPC port connectivity
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import socket; socket.create_connection(('localhost', 8080), timeout=2)" || exit 1

# Default command
CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "8080", "--num_rounds", "10"]

# =============================================================================
# BUILD & RUN INSTRUCTIONS:
# 
# BUILD:
#   docker build -f Dockerfile.server -t fl-weather-server:latest .
#
# RUN (local):
#   docker run -d --name fl-server -p 8080:8080 fl-weather-server:latest
#
# RUN (GCP Cloud Run):
#   gcloud run deploy fl-server --source . --port 8080 --memory 1Gi
# =============================================================================
